// TrackingCrypt - Prisma Schema
// SQL Server provider with full financial precision

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────
// AUTH.JS REQUIRED TABLES
// ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER") // USER | ADMIN
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  priceGapEvents      PriceGapEvent[]
  tradingOrders       TradingOrder[]
  userSettings        UserSettings?
  alerts              Alert[]
  auditLogs           AuditLog[]
  exchangeCredentials ExchangeCredential[]
  portfolios          Portfolio[]
  brokerConnections   BrokerConnection[]

  @@map("Users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("PasswordResetTokens")
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationTokens")
}

// ─────────────────────────────────────────────────
// EXCHANGE & MARKET DATA
// ─────────────────────────────────────────────────

model Exchange {
  id          String   @id @default(cuid())
  name        String   @unique        // e.g., "binance", "coinbase", "mock"
  displayName String                  // e.g., "Binance", "Coinbase", "Mock (Dev)"
  baseApiUrl  String
  wsUrl       String?
  isEnabled   Boolean  @default(true)
  isMock      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tradingPairs        TradingPair[]
  marketSnapshots     MarketSnapshot[]
  orderBookLevels     OrderBookLevel[]
  priceGapEvents      PriceGapEvent[]
  latencyMetrics      LatencyMetric[]
  tradingOrders       TradingOrder[]
  exchangeCredentials ExchangeCredential[]

  @@map("Exchanges")
}

model TradingPair {
  id            String   @id @default(cuid())
  exchangeId    String
  symbol        String                    // e.g., "BTCUSDT", "BTCINR"
  baseCurrency  String                    // e.g., "BTC"
  quoteCurrency String                    // e.g., "INR", "USDT"
  isEnabled     Boolean  @default(true)
  minQuantity   Decimal? @db.Decimal(30, 10)
  maxQuantity   Decimal? @db.Decimal(30, 10)
  tickSize      Decimal? @db.Decimal(30, 10) // price precision
  stepSize      Decimal? @db.Decimal(30, 10) // quantity precision
  createdAt     DateTime @default(now())

  exchange        Exchange         @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  marketSnapshots MarketSnapshot[]
  orderBookLevels OrderBookLevel[]
  priceGapEvents  PriceGapEvent[]
  latencyMetrics  LatencyMetric[]
  tradingOrders   TradingOrder[]

  @@unique([exchangeId, symbol])
  @@index([exchangeId])
  @@map("TradingPairs")
}

model MarketSnapshot {
  id                 String   @id @default(cuid())
  exchangeId         String
  tradingPairId      String
  lastPrice          Decimal  @db.Decimal(30, 10)
  bestBid            Decimal  @db.Decimal(30, 10)
  bestAsk            Decimal  @db.Decimal(30, 10)
  bidQuantity        Decimal  @db.Decimal(30, 10)
  askQuantity        Decimal  @db.Decimal(30, 10)
  spread             Decimal  @db.Decimal(30, 10)
  spreadPercentage   Decimal  @db.Decimal(10, 6)
  volume24h          Decimal? @db.Decimal(30, 10)
  high24h            Decimal? @db.Decimal(30, 10)
  low24h             Decimal? @db.Decimal(30, 10)
  exchangeTimestamp  DateTime
  receivedAt         DateTime
  dataAgeMs          Int      // milliseconds between exchange ts and received ts
  createdAt          DateTime @default(now())

  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exchangeId, tradingPairId, createdAt(sort: Desc)])
  @@index([tradingPairId, createdAt(sort: Desc)])
  @@map("MarketSnapshots")
}

model OrderBookLevel {
  id                String   @id @default(cuid())
  exchangeId        String
  tradingPairId     String
  side              String   // "BID" | "ASK"
  price             Decimal  @db.Decimal(30, 10)
  quantity          Decimal  @db.Decimal(30, 10)
  snapshotTimestamp DateTime
  createdAt         DateTime @default(now())

  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exchangeId, tradingPairId, side, snapshotTimestamp(sort: Desc)])
  @@map("OrderBookLevels")
}

// ─────────────────────────────────────────────────
// PRICE GAP & LATENCY
// ─────────────────────────────────────────────────

model PriceGapEvent {
  id                       String   @id @default(cuid())
  userId                   String?
  exchangeId               String
  tradingPairId            String
  side                     String   // "BUY" | "SELL"
  referencePrice           Decimal  @db.Decimal(30, 10)
  observedPrice            Decimal  @db.Decimal(30, 10)
  estimatedExecutionPrice  Decimal  @db.Decimal(30, 10)
  quantity                 Decimal? @db.Decimal(30, 10)
  gapAmount                Decimal  @db.Decimal(30, 10)
  gapPercentage            Decimal  @db.Decimal(10, 6)
  additionalCost           Decimal? @db.Decimal(30, 10) // for BUY orders
  dataAgeMs                Int
  detectionTimestamp       DateTime
  gapClassification        String   // "SPREAD" | "MARKET_MOVEMENT" | "LIQUIDITY" | "FEES" | "STALE_DATA" | "SLIPPAGE" | "MIXED" | "UNKNOWN"
  isWithinTolerance        Boolean  @default(false)
  tolerancePercentage      Decimal? @db.Decimal(10, 6)
  createdAt                DateTime @default(now())

  user        User?       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)])
  @@index([exchangeId, tradingPairId, createdAt(sort: Desc)])
  @@map("PriceGapEvents")
}

model LatencyMetric {
  id                      String    @id @default(cuid())
  exchangeId              String
  tradingPairId           String
  exchangeEventTimestamp  DateTime
  serverReceivedAt        DateTime
  browserReceivedAt       DateTime?
  orderSubmittedAt        DateTime?
  exchangeAcknowledgedAt  DateTime?
  executionTimestamp      DateTime?
  measuredLatencyMs       Int       // server receive - exchange event (ms)
  e2eLatencyMs            Int?      // browser receive - exchange event (ms)
  metricType              String    // "MARKET_DATA" | "ORDER_SUBMIT" | "ORDER_ACK" | "ORDER_FILL"
  createdAt               DateTime  @default(now())

  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exchangeId, tradingPairId, createdAt(sort: Desc)])
  @@index([metricType, createdAt(sort: Desc)])
  @@map("LatencyMetrics")
}

// ─────────────────────────────────────────────────
// ORDERS & FILLS
// ─────────────────────────────────────────────────

model TradingOrder {
  id                    String    @id @default(cuid())
  userId                String
  exchangeId            String
  tradingPairId         String
  side                  String    // "BUY" | "SELL"
  orderType             String    // "MARKET" | "LIMIT" | "POST_ONLY" | "IOC" | "FOK"
  requestedQuantity     Decimal   @db.Decimal(30, 10)
  limitPrice            Decimal?  @db.Decimal(30, 10)
  averageExecutionPrice Decimal?  @db.Decimal(30, 10)
  filledQuantity        Decimal   @db.Decimal(30, 10) @default(0)
  totalFees             Decimal?  @db.Decimal(30, 10)
  feeCurrency           String?
  status                String    // "PENDING" | "OPEN" | "PARTIALLY_FILLED" | "FILLED" | "CANCELLED" | "REJECTED" | "EXPIRED"
  exchangeOrderId       String?
  clientOrderId         String?   @unique // idempotency key
  portfolioId           String?
  isPaperTrade          Boolean   @default(true)
  rejectionReason       String?
  cancelledAt           DateTime?
  executedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  portfolio   Portfolio?  @relation(fields: [portfolioId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fills       TradeFill[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([portfolioId])
  @@index([status, createdAt(sort: Desc)])
  @@map("TradingOrders")
}

model TradeFill {
  id             String   @id @default(cuid())
  tradingOrderId String
  exchangeTradeId String?
  price          Decimal  @db.Decimal(30, 10)
  quantity       Decimal  @db.Decimal(30, 10)
  feeAmount      Decimal  @db.Decimal(30, 10)
  feeCurrency    String
  executedAt     DateTime
  createdAt      DateTime @default(now())

  tradingOrder TradingOrder @relation(fields: [tradingOrderId], references: [id], onDelete: Cascade)

  @@index([tradingOrderId])
  @@map("TradeFills")
}

// ─────────────────────────────────────────────────
// USER SETTINGS & ALERTS
// ─────────────────────────────────────────────────

model UserSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  preferredCurrency         String   @default("INR")
  preferredExchangeId       String?
  preferredTradingPairId    String?
  maximumBuyPrice           Decimal? @db.Decimal(30, 10)
  minimumSellPrice          Decimal? @db.Decimal(30, 10)
  maximumAllowedGapPct      Decimal  @db.Decimal(10, 6) @default(2.0)
  enablePriceAlerts         Boolean  @default(true)
  enableEmailAlerts         Boolean  @default(false)
  enablePaperTrading        Boolean  @default(true)
  defaultOrderQuantity      Decimal? @db.Decimal(30, 10)
  theme                     String   @default("dark")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserSettings")
}

model Alert {
  id                String    @id @default(cuid())
  userId            String
  alertType         String    // "PRICE_TARGET" | "MAX_BUY_EXCEEDED" | "MIN_SELL_BELOW" | "GAP_EXCEEDED" | "DATA_STALE" | "WS_DISCONNECT" | "ORDER_FAIL" | "FILL"
  exchangeId        String?
  tradingPairId     String?
  message           String
  severity          String    @default("INFO") // "INFO" | "WARNING" | "CRITICAL"
  isRead            Boolean   @default(false)
  isEnabled         Boolean   @default(true)
  triggerValue      Decimal?  @db.Decimal(30, 10)
  thresholdValue    Decimal?  @db.Decimal(30, 10)
  cooldownSeconds   Int       @default(300) // prevent duplicate alerts
  lastTriggeredAt   DateTime?
  triggeredCount    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([alertType, createdAt(sort: Desc)])
  @@map("Alerts")
}

// ─────────────────────────────────────────────────
// SECURITY & AUDIT
// ─────────────────────────────────────────────────

model ExchangeCredential {
  id                  String   @id @default(cuid())
  userId              String
  exchangeId          String
  label               String   // user-friendly label
  encryptedApiKey     String   @db.Text
  encryptedApiSecret  String   @db.Text
  keyIv               String   // AES IV hex
  permissions         String   @default("READ_ONLY") // "READ_ONLY" | "TRADE"
  isActive            Boolean  @default(true)
  lastVerifiedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange Exchange @relation(fields: [exchangeId], references: [id])

  @@unique([userId, exchangeId, label])
  @@map("ExchangeCredentials")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g., "ORDER_SUBMITTED", "CREDENTIAL_ADDED", "SETTINGS_CHANGED"
  entityType String?  // e.g., "TradingOrder", "Alert"
  entityId   String?
  metadata   String?  @db.Text // JSON string (no secrets)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("AuditLogs")
}

// ─────────────────────────────────────────────────
// MULTI-ASSET TRADING PLATFORM MODELS
// ─────────────────────────────────────────────────

model Instrument {
  id              String   @id @default(cuid())
  symbol          String   @unique // e.g., "BTC", "GOLD", "SILVER", "CRUDEOIL"
  name            String
  category        String   // "CRYPTO" | "MCX_COMMODITY" | "OPTION"
  subCategory     String?  // "PRECIOUS_METALS" | "ENERGY" | "BASE_METALS" | "SPOT_CRYPTO"
  currency        String   @default("INR") // "INR" | "USDT"
  tickSize        Decimal  @db.Decimal(30, 10)
  lotSize         Decimal  @db.Decimal(30, 10) @default(1)
  unit            String   // "1 kg", "100 g", "BBL", "mmBtu", "coin"
  tradingHours    String?  // e.g., "09:00 - 23:30 IST"
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  commodityContracts CommodityContract[]
  optionContracts    OptionContract[]
  portfolioAssets    PortfolioAsset[]
  portfolioPositions PortfolioPosition[]

  @@map("Instruments")
}

model CommodityContract {
  id                 String   @id @default(cuid())
  instrumentId       String
  contractSymbol     String   @unique // e.g. "GOLD26AUGFUT", "SILVER26SEPFUT"
  contractName       String
  category           String   // "PRECIOUS_METALS" | "ENERGY" | "BASE_METALS"
  expiryDate         DateTime
  tenderStartDate    DateTime?
  deliveryType       String   @default("PHYSICAL") // "PHYSICAL" | "CASH"
  lotSize            Decimal  @db.Decimal(30, 10)
  tickSize           Decimal  @db.Decimal(30, 10)
  openInterest       Decimal  @db.Decimal(30, 10) @default(0)
  lastTradedPrice    Decimal  @db.Decimal(30, 10)
  isLive             Boolean  @default(true)
  createdAt          DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([category, expiryDate])
  @@map("CommodityContracts")
}

model OptionContract {
  id                 String   @id @default(cuid())
  instrumentId       String
  symbol             String   @unique // e.g., "BTC-30OCT26-85000-CE"
  underlying         String
  category           String   // "CRYPTO" | "MCX_COMMODITY"
  optionType         String   // "CE" | "PE"
  strikePrice        Decimal  @db.Decimal(30, 10)
  expiryDate         DateTime
  lotSize            Decimal  @db.Decimal(30, 10) @default(1)
  impliedVolatility  Decimal  @db.Decimal(10, 6) @default(0)
  lastTradedPrice    Decimal  @db.Decimal(30, 10) @default(0)
  bestBid            Decimal  @db.Decimal(30, 10) @default(0)
  bestAsk            Decimal  @db.Decimal(30, 10) @default(0)
  volume             Decimal  @db.Decimal(30, 10) @default(0)
  openInterest       Decimal  @db.Decimal(30, 10) @default(0)
  isLive             Boolean  @default(true)
  createdAt          DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([underlying, expiryDate, strikePrice])
  @@map("OptionContracts")
}

model Portfolio {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  description         String?
  category            String   // "CRYPTO" | "GOLD" | "SILVER" | "MCX_COMMODITY" | "OPTIONS_TRADING" | "MULTI_ASSET" | "CUSTOM"
  currency            String   @default("INR") // "INR" | "USDT"
  initialCapital      Decimal  @db.Decimal(30, 10)
  totalCapital        Decimal  @db.Decimal(30, 10)
  allocatedCapital    Decimal  @db.Decimal(30, 10) @default(0)
  availableBalance    Decimal  @db.Decimal(30, 10)
  investedAmount      Decimal  @db.Decimal(30, 10) @default(0)
  currentMarketValue  Decimal  @db.Decimal(30, 10) @default(0)
  realizedPnL         Decimal  @db.Decimal(30, 10) @default(0)
  unrealizedPnL       Decimal  @db.Decimal(30, 10) @default(0)
  totalCharges        Decimal  @db.Decimal(30, 10) @default(0)
  maxInvestmentLimit  Decimal  @db.Decimal(30, 10)
  riskLimitPercentage Decimal  @db.Decimal(10, 6) @default(5.0)
  maxDailyLoss        Decimal  @db.Decimal(30, 10) @default(10000)
  reviewDate          DateTime?
  status              String   @default("READY") // "READY" | "RUNNING" | "PAUSED" | "STOPPING" | "STOPPED" | "EXPIRED" | "ERROR"
  executionMode       String   @default("PAPER") // "PAPER" | "LIVE"
  connectedBrokerId   String?
  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brokerConnection BrokerConnection?  @relation(fields: [connectedBrokerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets           PortfolioAsset[]
  positions        PortfolioPosition[]
  orders           TradingOrder[]
  history          PortfolioHistory[]

  @@index([userId, status])
  @@map("Portfolios")
}

model PortfolioAsset {
  id                  String   @id @default(cuid())
  portfolioId         String
  instrumentId        String
  targetAllocationPct Decimal  @db.Decimal(10, 6) // e.g. 25.0%
  currentValue        Decimal  @db.Decimal(30, 10) @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([portfolioId, instrumentId])
  @@map("PortfolioAssets")
}

model PortfolioPosition {
  id                 String   @id @default(cuid())
  portfolioId        String
  instrumentId       String
  symbol             String
  name               String
  category           String   // "CRYPTO" | "MCX_COMMODITY" | "OPTION"
  side               String   // "BUY" | "SELL"
  optionType         String?  // "CE" | "PE"
  strikePrice        Decimal? @db.Decimal(30, 10)
  expiryDate         DateTime?
  quantity           Decimal  @db.Decimal(30, 10)
  entryPrice         Decimal  @db.Decimal(30, 10)
  currentPrice       Decimal  @db.Decimal(30, 10)
  investedAmount     Decimal  @db.Decimal(30, 10)
  currentMarketValue Decimal  @db.Decimal(30, 10)
  unrealizedPnL      Decimal  @db.Decimal(30, 10)
  unrealizedPnLPct   Decimal  @db.Decimal(10, 6)
  realizedPnL        Decimal  @db.Decimal(30, 10) @default(0)
  stopLossPrice      Decimal? @db.Decimal(30, 10)
  targetPrice        Decimal? @db.Decimal(30, 10)
  totalCharges       Decimal  @db.Decimal(30, 10) @default(0)
  status             String   @default("OPEN") // "OPEN" | "CLOSED"
  openedAt           DateTime @default(now())
  closedAt           DateTime?
  lastUpdatedAt      DateTime @updatedAt

  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([portfolioId, status])
  @@map("PortfolioPositions")
}

model PortfolioHistory {
  id                 String   @id @default(cuid())
  portfolioId        String
  timestamp          DateTime @default(now())
  totalCapital       Decimal  @db.Decimal(30, 10)
  investedAmount     Decimal  @db.Decimal(30, 10)
  realizedPnL        Decimal  @db.Decimal(30, 10)
  unrealizedPnL      Decimal  @db.Decimal(30, 10)
  totalReturnPct     Decimal  @db.Decimal(10, 6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, timestamp(sort: Desc)])
  @@map("PortfolioHistory")
}

model BrokerConnection {
  id                     String    @id @default(cuid())
  userId                 String
  brokerType             String    // "ZERODHA" | "ANGEL_ONE" | "UPSTOX" | "DHAN" | "BINANCE" | "COINDCX" | "PAPER_SIMULATOR"
  displayName            String
  accountUserId          String
  encryptedApiKey        String    @db.Text
  encryptedApiSecret     String    @db.Text
  encryptedAccessToken   String?   @db.Text
  keyIv                  String
  isConnected            Boolean   @default(true)
  isLiveTradingAuthorized Boolean  @default(false)
  lastSyncAt             DateTime?
  supportedSegments      String    // Comma-separated: "EQUITY,COMMODITY,CRYPTO,FUTURES,OPTIONS"
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  portfolios Portfolio[]

  @@unique([userId, brokerType, accountUserId])
  @@map("BrokerConnections")
}

model ExpiryNotification {
  id              String   @id @default(cuid())
  symbol          String
  contractName    String
  expiryDate      DateTime
  noticeType      String   // "DAYS_7" | "DAYS_3" | "DAYS_1" | "EXPIRY_DAY" | "TENDER_NOTICE"
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([expiryDate])
  @@map("ExpiryNotifications")
}
