# TrackingCrypt Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# SQL Server connection string
# Format: sqlserver://HOST:PORT;database=DATABASE;user=USER;password=PASSWORD;encrypt=true
DATABASE_URL="sqlserver://localhost:1433;database=TrackingCrypt;user=sa;password=YourPassword123!;encrypt=false;trustServerCertificate=true"

# ─── Authentication (Auth.js v5) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_32_CHAR_SECRET"

# Application URL
NEXTAUTH_URL="http://localhost:3000"

# ─── Encryption (for exchange credentials at rest) ───────────────────────────
# 32-byte hex key for AES-256 encryption
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHAR_KEY"

# ─── Exchange Configuration ───────────────────────────────────────────────────
# Set to "true" to enable mock adapter in any environment
USE_MOCK_EXCHANGE="true"

# Binance (optional — only needed when USE_MOCK_EXCHANGE=false)
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_BASE_URL="https://api.binance.com"
BINANCE_WS_URL="wss://stream.binance.com:9443"

# CoinDCX (optional — Indian exchange, INR pairs)
COINDCX_API_KEY=""
COINDCX_API_SECRET=""
COINDCX_BASE_URL="https://api.coindcx.com"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE="60"
RATE_LIMIT_ORDERS_PER_MINUTE="10"

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_LIVE_TRADING="false"
NEXT_PUBLIC_ENABLE_PAPER_TRADING="true"
