// TrackingCrypt - Prisma Schema
// SQL Server provider with full financial precision

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────
// AUTH.JS REQUIRED TABLES
// ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("USER") // USER | ADMIN
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  priceGapEvents      PriceGapEvent[]
  tradingOrders       TradingOrder[]
  userSettings        UserSettings?
  alerts              Alert[]
  auditLogs           AuditLog[]
  exchangeCredentials ExchangeCredential[]

  @@map("Users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("PasswordResetTokens")
}


model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("Accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("VerificationTokens")
}

// ─────────────────────────────────────────────────
// EXCHANGE & MARKET DATA
// ─────────────────────────────────────────────────

model Exchange {
  id          String   @id @default(cuid())
  name        String   @unique        // e.g., "binance", "coinbase", "mock"
  displayName String                  // e.g., "Binance", "Coinbase", "Mock (Dev)"
  baseApiUrl  String
  wsUrl       String?
  isEnabled   Boolean  @default(true)
  isMock      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tradingPairs        TradingPair[]
  marketSnapshots     MarketSnapshot[]
  orderBookLevels     OrderBookLevel[]
  priceGapEvents      PriceGapEvent[]
  latencyMetrics      LatencyMetric[]
  tradingOrders       TradingOrder[]
  exchangeCredentials ExchangeCredential[]

  @@map("Exchanges")
}

model TradingPair {
  id            String   @id @default(cuid())
  exchangeId    String
  symbol        String                    // e.g., "BTCUSDT", "BTCINR"
  baseCurrency  String                    // e.g., "BTC"
  quoteCurrency String                    // e.g., "INR", "USDT"
  isEnabled     Boolean  @default(true)
  minQuantity   Decimal? @db.Decimal(30, 10)
  maxQuantity   Decimal? @db.Decimal(30, 10)
  tickSize      Decimal? @db.Decimal(30, 10) // price precision
  stepSize      Decimal? @db.Decimal(30, 10) // quantity precision
  createdAt     DateTime @default(now())

  exchange        Exchange         @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  marketSnapshots MarketSnapshot[]
  orderBookLevels OrderBookLevel[]
  priceGapEvents  PriceGapEvent[]
  latencyMetrics  LatencyMetric[]
  tradingOrders   TradingOrder[]

  @@unique([exchangeId, symbol])
  @@index([exchangeId])
  @@map("TradingPairs")
}

model MarketSnapshot {
  id                 String   @id @default(cuid())
  exchangeId         String
  tradingPairId      String
  lastPrice          Decimal  @db.Decimal(30, 10)
  bestBid            Decimal  @db.Decimal(30, 10)
  bestAsk            Decimal  @db.Decimal(30, 10)
  bidQuantity        Decimal  @db.Decimal(30, 10)
  askQuantity        Decimal  @db.Decimal(30, 10)
  spread             Decimal  @db.Decimal(30, 10)
  spreadPercentage   Decimal  @db.Decimal(10, 6)
  volume24h          Decimal? @db.Decimal(30, 10)
  high24h            Decimal? @db.Decimal(30, 10)
  low24h             Decimal? @db.Decimal(30, 10)
  exchangeTimestamp  DateTime
  receivedAt         DateTime
  dataAgeMs          Int      // milliseconds between exchange ts and received ts
  createdAt          DateTime @default(now())

  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exchangeId, tradingPairId, createdAt(sort: Desc)])
  @@index([tradingPairId, createdAt(sort: Desc)])
  @@map("MarketSnapshots")
}

model OrderBookLevel {
  id                String   @id @default(cuid())
  exchangeId        String
  tradingPairId     String
  side              String   // "BID" | "ASK"
  price             Decimal  @db.Decimal(30, 10)
  quantity          Decimal  @db.Decimal(30, 10)
  snapshotTimestamp DateTime
  createdAt         DateTime @default(now())

  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exchangeId, tradingPairId, side, snapshotTimestamp(sort: Desc)])
  @@map("OrderBookLevels")
}

// ─────────────────────────────────────────────────
// PRICE GAP & LATENCY
// ─────────────────────────────────────────────────

model PriceGapEvent {
  id                       String   @id @default(cuid())
  userId                   String?
  exchangeId               String
  tradingPairId            String
  side                     String   // "BUY" | "SELL"
  referencePrice           Decimal  @db.Decimal(30, 10)
  observedPrice            Decimal  @db.Decimal(30, 10)
  estimatedExecutionPrice  Decimal  @db.Decimal(30, 10)
  quantity                 Decimal? @db.Decimal(30, 10)
  gapAmount                Decimal  @db.Decimal(30, 10)
  gapPercentage            Decimal  @db.Decimal(10, 6)
  additionalCost           Decimal? @db.Decimal(30, 10) // for BUY orders
  dataAgeMs                Int
  detectionTimestamp       DateTime
  gapClassification        String   // "SPREAD" | "MARKET_MOVEMENT" | "LIQUIDITY" | "FEES" | "STALE_DATA" | "SLIPPAGE" | "MIXED" | "UNKNOWN"
  isWithinTolerance        Boolean  @default(false)
  tolerancePercentage      Decimal? @db.Decimal(10, 6)
  createdAt                DateTime @default(now())

  user        User?       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)])
  @@index([exchangeId, tradingPairId, createdAt(sort: Desc)])
  @@map("PriceGapEvents")
}

model LatencyMetric {
  id                      String    @id @default(cuid())
  exchangeId              String
  tradingPairId           String
  exchangeEventTimestamp  DateTime
  serverReceivedAt        DateTime
  browserReceivedAt       DateTime?
  orderSubmittedAt        DateTime?
  exchangeAcknowledgedAt  DateTime?
  executionTimestamp      DateTime?
  measuredLatencyMs       Int       // server receive - exchange event (ms)
  e2eLatencyMs            Int?      // browser receive - exchange event (ms)
  metricType              String    // "MARKET_DATA" | "ORDER_SUBMIT" | "ORDER_ACK" | "ORDER_FILL"
  createdAt               DateTime  @default(now())

  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exchangeId, tradingPairId, createdAt(sort: Desc)])
  @@index([metricType, createdAt(sort: Desc)])
  @@map("LatencyMetrics")
}

// ─────────────────────────────────────────────────
// ORDERS & FILLS
// ─────────────────────────────────────────────────

model TradingOrder {
  id                    String    @id @default(cuid())
  userId                String
  exchangeId            String
  tradingPairId         String
  side                  String    // "BUY" | "SELL"
  orderType             String    // "MARKET" | "LIMIT" | "POST_ONLY" | "IOC" | "FOK"
  requestedQuantity     Decimal   @db.Decimal(30, 10)
  limitPrice            Decimal?  @db.Decimal(30, 10)
  averageExecutionPrice Decimal?  @db.Decimal(30, 10)
  filledQuantity        Decimal   @db.Decimal(30, 10) @default(0)
  totalFees             Decimal?  @db.Decimal(30, 10)
  feeCurrency           String?
  status                String    // "PENDING" | "OPEN" | "PARTIALLY_FILLED" | "FILLED" | "CANCELLED" | "REJECTED" | "EXPIRED"
  exchangeOrderId       String?
  clientOrderId         String?   @unique // idempotency key
  isPaperTrade          Boolean   @default(true)
  rejectionReason       String?
  cancelledAt           DateTime?
  executedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exchange    Exchange    @relation(fields: [exchangeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tradingPair TradingPair @relation(fields: [tradingPairId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fills       TradeFill[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("TradingOrders")
}

model TradeFill {
  id             String   @id @default(cuid())
  tradingOrderId String
  exchangeTradeId String?
  price          Decimal  @db.Decimal(30, 10)
  quantity       Decimal  @db.Decimal(30, 10)
  feeAmount      Decimal  @db.Decimal(30, 10)
  feeCurrency    String
  executedAt     DateTime
  createdAt      DateTime @default(now())

  tradingOrder TradingOrder @relation(fields: [tradingOrderId], references: [id], onDelete: Cascade)

  @@index([tradingOrderId])
  @@map("TradeFills")
}

// ─────────────────────────────────────────────────
// USER SETTINGS & ALERTS
// ─────────────────────────────────────────────────

model UserSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  preferredCurrency         String   @default("INR")
  preferredExchangeId       String?
  preferredTradingPairId    String?
  maximumBuyPrice           Decimal? @db.Decimal(30, 10)
  minimumSellPrice          Decimal? @db.Decimal(30, 10)
  maximumAllowedGapPct      Decimal  @db.Decimal(10, 6) @default(2.0)
  enablePriceAlerts         Boolean  @default(true)
  enableEmailAlerts         Boolean  @default(false)
  enablePaperTrading        Boolean  @default(true)
  defaultOrderQuantity      Decimal? @db.Decimal(30, 10)
  theme                     String   @default("dark")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserSettings")
}

model Alert {
  id                String    @id @default(cuid())
  userId            String
  alertType         String    // "PRICE_TARGET" | "MAX_BUY_EXCEEDED" | "MIN_SELL_BELOW" | "GAP_EXCEEDED" | "DATA_STALE" | "WS_DISCONNECT" | "ORDER_FAIL" | "FILL"
  exchangeId        String?
  tradingPairId     String?
  message           String
  severity          String    @default("INFO") // "INFO" | "WARNING" | "CRITICAL"
  isRead            Boolean   @default(false)
  isEnabled         Boolean   @default(true)
  triggerValue      Decimal?  @db.Decimal(30, 10)
  thresholdValue    Decimal?  @db.Decimal(30, 10)
  cooldownSeconds   Int       @default(300) // prevent duplicate alerts
  lastTriggeredAt   DateTime?
  triggeredCount    Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([alertType, createdAt(sort: Desc)])
  @@map("Alerts")
}

// ─────────────────────────────────────────────────
// SECURITY & AUDIT
// ─────────────────────────────────────────────────

model ExchangeCredential {
  id                  String   @id @default(cuid())
  userId              String
  exchangeId          String
  label               String   // user-friendly label
  encryptedApiKey     String   @db.Text
  encryptedApiSecret  String   @db.Text
  keyIv               String   // AES IV hex
  permissions         String   @default("READ_ONLY") // "READ_ONLY" | "TRADE"
  isActive            Boolean  @default(true)
  lastVerifiedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange Exchange @relation(fields: [exchangeId], references: [id])

  @@unique([userId, exchangeId, label])
  @@map("ExchangeCredentials")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g., "ORDER_SUBMITTED", "CREDENTIAL_ADDED", "SETTINGS_CHANGED"
  entityType String?  // e.g., "TradingOrder", "Alert"
  entityId   String?
  metadata   String?  @db.Text // JSON string (no secrets)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("AuditLogs")
}
